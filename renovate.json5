{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],
  schedule: [
    'before 6am on Saturday',
  ],
  timezone: 'Europe/Brussels',
  packageRules: [
    {
      // A digest update on a version tag is a rebuild of that same version.
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      // On a floating tag a digest update can be any upgrade, majors included.
      // Pin images to a version tag instead of using these.
      matchDatasources: [
        'docker',
      ],
      matchCurrentValue: '/^(latest|stable|main|master|edge|nightly|release)$/',
      automerge: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      labels: [
        'major-update',
      ],
    },
    {
      groupName: 'linuxserver media stack',
      matchPackageNames: [
        '/linuxserver/(prowlarr|radarr|sonarr|qbittorrent|plex|overseerr)/',
      ],
    },
    {
      // Tags look like 1.43.5.11079-b3b13e506-ls333. The commit hash in the
      // middle stops the default docker versioning from comparing them.
      matchPackageNames: [
        'lscr.io/linuxserver/plex',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+-ls(?<revision>\\d+)$',
    },
    {
      matchPackageNames: [
        'kube-prometheus-stack',
        'loki',
        'promtail',
        'grafana',
      ],
      groupName: 'observability stack',
    },
    {
      matchDatasources: [
        'docker',
      ],
      pinDigests: true,
    },
    {
      matchPackageNames: [
        'siderolabs/talos',
        'kubernetes/kubernetes',
      ],
      groupName: 'talos infrastructure',
      automerge: false,
      labels: [
        'infrastructure',
        'talos',
      ],
    },
    {
      // Must follow talosVersion and the etcd minor Talos ships: bump by hand.
      matchPackageNames: [
        'ghcr.io/siderolabs/talosctl',
        'gcr.io/etcd-development/etcd',
      ],
      automerge: false,
      labels: [
        'infrastructure',
        'talos',
      ],
    },
  ],
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+/values\\.yaml$/',
      // Inline Helm values in ArgoCD Applications (e.g. cloudflared).
      '/kubernetes/.+/application\\.yaml$/',
    ],
  },
  terraform: {
    managerFilePatterns: [
      '/terraform/.+\\.tf$/',
    ],
  },
  commitMessagePrefix: 'chore(deps):',
  commitMessageAction: 'update',
  prHourlyLimit: 5,
  prConcurrentLimit: 10,
  labels: [
    'dependencies',
    'renovate',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/talos/talconfig\\.yaml$/',
      ],
      matchStrings: [
        'talosVersion:\\s*(?<currentValue>v[\\d\\.]+)',
      ],
      depNameTemplate: 'siderolabs/talos',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/talos/talconfig\\.yaml$/',
      ],
      matchStrings: [
        'kubernetesVersion:\\s*(?<currentValue>v[\\d\\.]+)',
      ],
      depNameTemplate: 'kubernetes/kubernetes',
      datasourceTemplate: 'github-releases',
    },
  ],
  ignoreTests: true
}
